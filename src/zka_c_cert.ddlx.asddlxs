@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Certification', typeNamePlural: 'Certifications',
                  title: { type: #STANDARD, value: 'Title' },
                  description: { type: #STANDARD, value: 'Issuer' } }
annotate entity ZKA_C_Cert
    with 
{
    @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                 label: 'Details', position: 10 } ]
  @UI.hidden: true
  CertUuid;
  @UI.hidden: true
  ParentUuid;

  @UI: { lineItem: [{ position: 10 }], identification: [{ position: 10 }] }
  @EndUserText.label: 'Certificate'
  Title;
  
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }] }
  @EndUserText.label: 'Issuer'
  Issuer;
  
  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }] }
  @EndUserText.label: 'Issued On'
  IssueDate;
  
  @UI: { lineItem: [{ position: 40 }], identification: [{ position: 40 }] }
  @EndUserText.label: 'Valid Until'
  ExpiryDate;
  
  @UI.identification: [{ position: 50 }]
  CredentialId;

  @UI.identification: [{ position: 60 }]
  CredentialUrl;

  @UI.hidden: true
  LocalLastChangedAt;
    
}