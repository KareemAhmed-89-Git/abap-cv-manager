@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Skill', typeNamePlural: 'Skills',
                  title: { type: #STANDARD, value: 'SkillName' },
                  description: { type: #STANDARD, value: 'Category' } }
annotate entity ZKA_C_Skill
    with 
{
    @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                 label: 'Details', position: 10 } ]
  @UI.hidden: true
  SkillUuid;
  
  @UI.hidden: true
  ParentUuid;

  @UI: { lineItem: [{ position: 10 }], identification: [{ position: 10 }] }
  @EndUserText.label: 'Skill'
  SkillName;
  
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }] }
  @EndUserText.label: 'Category'
  Category;
  
  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }] }
  @EndUserText.label: 'Level (1–5)'  
  SkillLevel;
  
  @UI: { lineItem: [{ position: 40 }], identification: [{ position: 40 }] }
  @EndUserText.label: 'Highlight'
  IsHighlight;

  @UI.hidden: true
  LocalLastChangedAt;
    
}