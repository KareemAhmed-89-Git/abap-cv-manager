@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Language', typeNamePlural: 'Languages',
                  title: { type: #STANDARD, value: 'LanguageName' },
                  description: { type: #STANDARD, value: 'LangLevel' } }
annotate entity ZKA_C_Lang
    with 
{
   @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                 label: 'Details', position: 10 } ]
  @UI.hidden: true
  LangUuid;
  @UI.hidden: true
  ParentUuid;

  @UI: { lineItem: [{ position: 10 }], identification: [{ position: 10 }] }
  @EndUserText.label: 'Language'
  LanguageName;
  
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }] }
  @EndUserText.label: 'Level'
  LangLevel;
  
  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }] }
  @EndUserText.label: 'ISO Code'
  LanguageCode;

  @UI.hidden: true
  LocalLastChangedAt; 
    
}